{
  "name": "darkgame",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first encrypted on-chain high-card MVP built with CoFHE and React.",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "compile": "node node_modules/hardhat/internal/cli/bootstrap.js compile",
    "test": "node node_modules/hardhat/internal/cli/bootstrap.js test",
    "deploy:localhost": "node node_modules/hardhat/internal/cli/bootstrap.js run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "node node_modules/hardhat/internal/cli/bootstrap.js run scripts/deploy.ts --network sepolia",
    "smoke:sepolia": "node node_modules/hardhat/internal/cli/bootstrap.js run scripts/smoke-sepolia.ts --network sepolia",
    "verify:app": "npm run compile && npm run test && npm run build"
  },
  "dependencies": {
    "@cofhe/sdk": "^0.5.2",
    "@fhenixprotocol/cofhe-contracts": "^0.1.3",
    "@openzeppelin/contracts": "^5.0.2",
    "fdir": "^6.5.0",
    "lucide-react": "1.14.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinyglobby": "^0.2.16",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@cofhe/hardhat-plugin": "^0.5.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "fp-ts": "1.19.3",
    "hardhat": "^2.22.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
